# Infisetu MIS - production settings for hrms.infisetu.in
#   cp .env.production.example .env  &&  chmod 600 .env
# Replace EVERY value marked CHANGE_ME. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Use letters/digits only in passwords (they are embedded in URLs).

HORILLA_ENV=production
DEBUG=False
TIME_ZONE=Asia/Kolkata

SECRET_KEY=CHANGE_ME_64_RANDOM_CHARACTERS
DB_INIT_PASSWORD=CHANGE_ME_UNIQUE

# "localhost" is only for the container health check.
ALLOWED_HOSTS=hrms.infisetu.in,localhost
CSRF_TRUSTED_ORIGINS=https://hrms.infisetu.in
SECURE_SSL_REDIRECT=True

# PostgreSQL / Redis run in Docker, published on 127.0.0.1 only.
POSTGRES_DB=horilla_db
POSTGRES_USER=horilla_user
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgres://horilla_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/horilla_db
DB_PORT=5432
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379/0

GUNICORN_WORKERS=2

# ---- Activity tracker (Infi Time Manager) on the same VPS ----
# Server-to-server over loopback; the public site is only for agents and the admin console.
ACTIVITY_TRACKER_URL=http://127.0.0.1:8100
ACTIVITY_TRACKER_API_KEY=itm_CHANGE_ME_create_in_tracker_console_settings
ACTIVITY_TRACKER_CONSOLE_URL=https://itm.infisetu.in

# ---- Microsoft sign-in: leave off until the Microsoft 365 tenant exists ----
SSO_ENABLED=False
SSO_DEV_MOCK=False
# SSO_ENABLED=True
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# SSO_ALLOWED_DOMAINS=infisetu.in
# Redirect URI to register in Entra (Web): https://hrms.infisetu.in/sso/callback/
